# 复制为本目录 .env 后再填写。不要提交 .env，不要写入真实口令。
# cp deploy/java/.env.example deploy/java/.env

# MySQL 5.7。Java 默认用 root 连接，因此 DB_PASSWORD 与 MYSQL_ROOT_PASSWORD 保持一致。
MYSQL_ROOT_PASSWORD=change-me-mysql-root
DB_NAME=flysee
DB_USER=root
DB_PASSWORD=change-me-mysql-root

# 管理员 token 的 HMAC 密钥。空库可新生成：openssl rand -base64 32
# 若沿用已有 nz_token，必须与 config/buildadmin.php 的 token.key 相同，否则旧 token 全部失效。
TOKEN_KEY=change-me-token-key

# EMQX 5.8 控制台 http://127.0.0.1:18083 ，用户名固定 admin。
EMQX_DASHBOARD_PASSWORD=change-me-emqx-dashboard

# Java 连接 EMQX 的账号。留空表示不带用户名（EMQX 未配置认证器时允许连接）。
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=

# 对象存储。STORAGE_PROVIDER 取 ali 或 minio。密钥留空时上传接口返回未配置，进程仍可启动。
STORAGE_PROVIDER=ali
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=cn-chengdu
STORAGE_CDN_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_ACCESS_KEY_SECRET=
STORAGE_ROLE_ARN=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 大疆机场 config 请求。留空则机场拿不到 license，平台 HTTP 仍可启动。
DJI_APP_ID=
DJI_APP_KEY=
DJI_APP_LICENSE=
DJI_NTP_SERVER_HOST=ntp.aliyun.com
DJI_NTP_SERVER_PORT=123

# 声网 token 代理。留空时接口返回「声网服务未配置」。
AGORA_TOKEN_URL=

# ZLMediaKit。这些变量只影响 Java 的 /api/Rtmp 响应，改不了已编译前端里的地址。
ZLM_API_SERVER=
ZLM_API_SECRET=
ZLM_RTMP_URL=
ZLM_FLV_URL=
ZLM_HLS_URL=
ZLM_RTMP_SECRET=

# 通义千问视频帧分析。留空时分析接口返回未配置。
DASHSCOPE_API_KEY=
